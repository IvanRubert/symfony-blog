{% extends 'base.html.twig' %}
{% block body %}
<div id="single">
     <div class="container">
{% if not post %}
    <h2>Post no encontrado</h2>
{% else %}
    <!-- Full Article -->
      <div class="row">
      <h2>{{post.title}}</h2>
      <hr class="subtitle">
      <div class=" block1">
      <div class="col-xs-12 col-sm-9">
          <img src="{{asset('images/blog/' ~ post.image) }}" alt="" width="500px">

        <p>{{post.content | nl2br}}</p>
        <h4>- By {{post.postUser.name}}</h4>
        <hr>
        <ul class="list-inline">
          <li>{{post.publishedAt | date('d') }} {{ post.publishedAt | date('F') }} |</li>
          <li><a class="page-scroll" href="#form">COMMENT</a> <i class="fa fa-comments sr-icons"></i> {{post.numComments}} |</li>
          <li>
            <a href="{{ path('post_like', {slug: post.slug}) }}" id="like-button">LIKE</a> 
            <i class="fa fa-heart sr-icons"></i>
            <span id="likes"> {{post.numLikes}}</span>
          </li>

        </ul>
      </div>
      <div class="col-xs-12 col-sm-3">
        <h4>Recent Post</h4>
        <hr class="subtitle1">
        {% for recent in recents %}
            {{ include ('partials/_recent_post.html.twig', {'recent': recent}) }}
        {% endfor %}
      </div>
      </div>
      </div>
    <!-- End of Full Article -->

    <!-- Comments -->
      <div class="row">
      <div class="col-xs-12 col-sm-12 block2">
        {% for comment in post.comments %}
          {{ include('partials/_comments.html.twig', {comment: comment}) }}
        {% endfor %}
        <hr class="line">
        {{ include ('partials/_post_comments.html.twig') }}
      </div>
      </div>
    <!-- End of Comments -->  
     </div>
   </div>
   
   {% endif %}
   {% if post %}
    <script type='text/javascript'>
    document.addEventListener('DOMContentLoaded', function() {
        const likeLink = document.querySelector('#like-button');
        // Hay que coger el id 'likes' para poder cambiar luego el valor al número de likes actual
        const likesSpan = document.querySelector('#likes');
        if (likeLink) {
        likeLink.addEventListener('click', function(event) {
            event.preventDefault();
            fetch(likeLink.href, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    likesSpan.innerHTML = " " + data.likes;
                }
            })
            .catch(error => console.error('Error:', error));
        });
      }
    });

</script>

   {% endif %}
{% endblock %}
