{% extends 'base.html.twig' %}
{% block title%}Images{% endblock %}
{% block body%}
<!-- Principal Content Start -->
   <div id="images">
        <div class="container">
            <div class="col-xs-12 col-sm-8 col-sm-push-2">
                <h1>Images</h1>
                <hr class="divider">
                {{ form_start(form, {'attr': {'class': 'form-horizontal'}})}}
                    <div class="form-group">
                        {{ form_row(form.file, {'attr': {'class': 'form-control'}})}}
                        {{ form_row(form.category, {'attr': {'class': 'form-horizontal'}})}}
                        {{ form_row(form.Send, {'attr': {'class': 'pull-right btn btn-lg sr-button'}})}}
                    </div>
                {{ form_end(form) }}
                <hr class="divider">
                <div>
             <table class="table">
                <thead>
                  <tr>
                    <th scope="col">#</th>
                    <th scope="col">File</th>
                    <th scope="col">Category</th>
                  </tr>
                </thead>
                <tbody>
                  {% for image in images %}
                    <tr>
                      <th scope="row">{{ image.id }}</th>
                      <td><img src="{{ asset('images/index/gallery/' ~ image.file) }}" alt="{{ image.file }}" width="100"></td>
                      <td>{{ image.category.name }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
             </table>
           </div>
            </div>   
        </div>
    </div>
<!-- Principal Content Start -->
{% endblock %}
